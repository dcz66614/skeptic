<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Agent Skepticism Leaderboard</title>
  <style>
    :root {
      --bg: #f6f8fa;
      --card: #ffffff;
      --text: #24292f;
      --muted: #57606a;
      --border: #d0d7de;
      --header: #1f2328;
      --header-text: #ffffff;
      --accent: #0969da;
      --success: #2ea043;
      --warning: #d29922;
      --danger: #cf222e;
      --stripe: #f6f8fa;
      --hover: #eaeef2;
      --banner: #fff8c5;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0d1117;
        --card: #161b22;
        --text: #c9d1d9;
        --muted: #8b949e;
        --border: #30363d;
        --header: #010409;
        --header-text: #f0f6fc;
        --accent: #58a6ff;
        --success: #3fb950;
        --warning: #d29922;
        --danger: #f85149;
        --stripe: #13171f;
        --hover: #1f242c;
        --banner: #3b3318;
      }
      .heat-cell-succ { background: #1b382b; color: #3fb950; }
      .heat-cell-warn { background: #3b3318; color: #d29922; }
      .heat-cell-danger { background: #3c1e1e; color: #f85149; }
    }
    * { box-sizing: border-box; }
    html, body { max-width: 100%; overflow-x: hidden; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    img, svg, video, canvas, pre { max-width: 100%; }
    header {
      background: var(--header);
      color: var(--header-text);
      padding: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      align-items: center;
      justify-content: space-between;
    }
    header a { color: var(--header-text); }
    header h1 { font-size: 1.15rem; margin: 0; font-weight: 650; }
    header p { margin: 2px 0 0; color: #8b949e; font-size: 0.85rem; }
    nav { display: flex; flex-wrap: wrap; gap: 12px; }
    nav a { text-decoration: none; }
    nav a:hover { text-decoration: underline; }
    .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 16px; min-width: 0; }
    h2 { font-size: 1.15rem; margin: 28px 0 10px; }
    p, li { max-width: 70rem; }
    a { color: var(--accent); }
    .banner {
      background: var(--banner);
      border: 1px solid var(--warning);
      border-radius: 8px;
      padding: 12px 14px;
      margin: 0 0 16px;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 12px;
    }
    label { font-size: 0.8rem; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
    select {
      font: inherit;
      color: var(--text);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      max-width: 100%;
    }
    .table-scroll { overflow-x: auto; max-width: 100%; }
    table { border-collapse: collapse; width: max-content; min-width: 100%; font-size: 0.9rem; }
    th, td { padding: 8px 10px; border: 1px solid var(--border); text-align: left; vertical-align: top; }
    th { background: var(--stripe); }
    tr:nth-child(even) td { background: var(--stripe); }
    tr:hover td { background: var(--hover); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      min-width: 0;
    }
    .card span { display: block; color: var(--muted); font-size: 0.78rem; font-weight: 650; }
    .card strong { font-size: 1.15rem; word-break: break-word; }
    .sks-high { color: var(--success); }
    .sks-mid { color: var(--warning); }
    .sks-low { color: var(--danger); }
    .heat-cell-0 { color: var(--muted); }
    .heat-cell-succ { background: #dafbe1; color: #1a7f37; font-weight: 650; }
    .heat-cell-warn { background: #fff8c5; color: #9a6700; font-weight: 650; }
    .heat-cell-danger { background: #ffebe9; color: #cf222e; font-weight: 650; }
    .formula {
      overflow-x: auto;
      max-width: 100%;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    footer { color: var(--muted); font-size: 0.8rem; margin-top: 28px; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1><a href="{{ root }}index.html">Agent Skepticism Leaderboard</a></h1>
      <p>智能体较真榜</p>
    </div>
    <nav>
      <a href="{{ root }}index.html">Board</a>
      <a href="{{ root }}guards.html">Guards</a>
      <a href="{{ root }}methodology.html">Methodology</a>
      <a href="{{ root }}data/results.csv">CSV</a>
      <a href="{{ root }}data/summary.json">JSON</a>
    </nav>
  </header>
  <main class="container">
    {% block main %}{% endblock %}
    <footer>
      Generated {{ generated_at }} · skeptic-agent {{ version }}
      {% if archives %}
        · {% for name in archives %}<a href="{{ root }}data/{{ name }}">{{ name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
      {% endif %}
    </footer>
  </main>
  {% block scripts %}{% endblock %}
</body>
</html>
