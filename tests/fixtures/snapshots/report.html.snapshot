<script>
  function toggleTheme() {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('skeptic-theme', next);
    } catch (e) {}
  }

  (function initTheme() {
    try {
      const saved = localStorage.getItem('skeptic-theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
      }
    } catch (e) {}
  })();

  function toggleDetails(rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;
    if (row.classList.contains('active')) {
      row.classList.remove('active');
    } else {
      row.classList.add('active');
    }
  }

  function applyFilters() {
    const outcomeVal = document.getElementById('filter-outcome').value;
    const faultVal = document.getElementById('filter-fault').value;
    const sandboxVal = document.getElementById('filter-sandbox').value;
    const searchVal = document.getElementById('filter-search').value.toLowerCase().trim();

    const rows = document.querySelectorAll('.ep-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const outcome = row.getAttribute('data-outcome');
      const fault = row.getAttribute('data-fault');
      const sandbox = row.getAttribute('data-sandbox');
      const scenario = row.getAttribute('data-scenario').toLowerCase();

      let match = true;
      if (outcomeVal !== 'ALL' && outcome !== outcomeVal) match = false;
      if (faultVal !== 'ALL' && fault !== faultVal) match = false;
      if (sandboxVal !== 'ALL' && sandbox !== sandboxVal) match = false;
      if (searchVal && !scenario.includes(searchVal)) match = false;

      const detailRowId = row.nextElementSibling && row.nextElementSibling.id;
      const detailRow = detailRowId ? document.getElementById(detailRowId) : null;

      if (match) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
        if (detailRow && detailRow.classList.contains('active')) {
          detailRow.classList.remove('active');
        }
      }
    });

    const countElem = document.getElementById('filter-count');
    if (countElem) {
      countElem.textContent = 'Showing ' + visibleCount + ' of ' + rows.length + ' episodes';
    }
  }
</script>

</body>
</html>