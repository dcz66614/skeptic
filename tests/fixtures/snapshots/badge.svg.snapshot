<svg xmlns="http://www.w3.org/2000/svg" width="108" height="20" role="img" aria-label="skeptic: SKS 45">
  <title>skeptic: SKS 45</title>
  <linearGradient id="s" x2="0" y2="100%">
    <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
    <stop offset="1" stop-opacity=".1"/>
  </linearGradient>
  <clipPath id="r">
    <rect width="108" height="20" rx="3" fill="#fff"/>
  </clipPath>
  <g clip-path="url(#r)">
    <rect width="52" height="20" fill="#555"/>
    <rect x="52" width="56" height="20" fill="#cf222e"/>
    <rect width="108" height="20" fill="url(#s)"/>
  </g>
  <g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" text-rendering="geometricPrecision" font-size="110">
    <text aria-hidden="true" x="260" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="364">skeptic</text>
    <text x="260" y="140" transform="scale(.1)" fill="#fff" textLength="364">skeptic</text>
    <text aria-hidden="true" x="800" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="392">SKS 45</text>
    <text x="800" y="140" transform="scale(.1)" fill="#fff" textLength="392">SKS 45</text>
  </g>
</svg>
